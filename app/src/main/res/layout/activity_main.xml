<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
<ScrollView android:id="@+id/controlScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false" android:scrollbars="vertical">
<LinearLayout android:id="@+id/controlPanel" android:orientation="vertical" android:padding="8dp" android:background="#FFFFFF" android:elevation="4dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Facebook Auto Like &amp; Reply" android:textStyle="bold" android:textSize="19sp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/url" android:hint="رابط المنشور" android:inputType="textUri" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/publicReply" android:hint="الرد العام (استخدم [اسم العميل])" android:inputType="textCapSentences|textMultiLine" android:minLines="2" android:maxLines="4" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/privateMessage" android:hint="الرسالة الخاصة" android:inputType="textCapSentences|textMultiLine" android:minLines="2" android:maxLines="4" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/noMessageReply" android:hint="الرد البديل لمن لا يظهر له إرسال رسالة" android:inputType="textCapSentences|textMultiLine" android:minLines="2" android:maxLines="4" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><EditText android:id="@+id/limit" android:hint="عدد الردود" android:text="10" android:inputType="number" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><EditText android:id="@+id/delay" android:hint="الفاصل بالثواني" android:text="10" android:inputType="number" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content"><CheckBox android:id="@+id/sendPrivate" android:text="إرسال الخاص" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/><CheckBox android:id="@+id/publicEnabled" android:text="الرد العام" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/open" android:text="فتح المنشور" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/start" android:text="بدء" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/stop" android:text="إيقاف" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/></LinearLayout>
<TextView android:id="@+id/status" android:text="متوقف" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/counters" android:text="تمت المعالجة: 0 | Likes: 0 | ردود: 0 | خاص: 0" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/log" android:text="السجل:" android:background="#F3F4F6" android:padding="6dp" android:maxLines="3" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="72dp"/>
</LinearLayout>
</ScrollView>
<TextView android:id="@+id/resizeHandle" android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center" android:text="اسحب الفاصل لتكبير أو تصغير المساحة" android:textSize="12sp" android:textColor="#444444" android:background="#E5E7EB" android:clickable="true" android:focusable="true" />
<WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="always" android:scrollbars="vertical" android:fadeScrollbars="false" android:focusable="true" android:focusableInTouchMode="true"/>
</LinearLayout>
